#[
    -------------------------------------
    ------ SELF-HOSTED DRAGONSTONE ------
    -------------------------------------
    ----------- BACKEND MODE ------------
    -------------------------------------
]#

module Dragonstone
    enum Mode
        Auto
        Native
        Core
    end

    alias BackendMode = Dragonstone::Mode

    define BackendMode.parse(input: str) -> Mode
        downcased   = input.downcase
        normalized  = downcased.strip

        case normalized

        when "", "auto"
            Mode::Auto
        when "native"
            Mode::Native
        when "core"
            Mode::Core
        else
            raise ArgumentError.new("Unknown backend '#{input}'; Expected auto, native, or core.")
        end
    end

    define label: str
        case self

        when Mode::Auto
            "auto"
        when Mode::Native
            "native"
        when Mode::Core
            "core"
        else
            "auto"
        end
    end
end
