#[

    This is using the file and path utilities from the 
    system library to build strings in a more efficient 
    way, without the need for imports.

    Location:
        `./src/dragonstone/syslib/modules/file.ds`
        `./src/dragonstone/syslib/modules/path.ds`
        `./src/dragonstone/syslib/modules/file/module.ds`
        `./src/dragonstone/syslib/modules/path/module.ds`

]#

tmp_dir = "./tmp_examples"
target = "#{tmp_dir}/demo.txt"

Path.create(tmp_dir)

create = File.create(target, "hello", true)
echo "create -> #{create}"
echo "read   -> #{File.read(target)}"

write = File.write(target, "world", true)
echo "write  -> bytes=#{write}"

append = File.append(target, "!", true)
echo "append -> bytes=#{append}"
echo "read   -> #{File.read(target)}"

open = File.open(target, "r", false)
echo "open   -> #{open}"
echo "read   -> #{File.read(target)}"

File.write(target, "Hello World", true)
File.append(target, "!", true)
echo "read   -> #{File.read(target)}"

echo "delete -> #{File.delete(target)}"
File.delete(tmp_dir)
