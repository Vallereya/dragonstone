#[
    Maps Example
]#

# Example One
# Map literal with key -> value pairs.
ages = { "Jules" -> 32, "Ringo" -> 29, "Peet" -> 35 }

# Access existing entries.
echo ages["Jules"]

# Example Two
# Update values via index assignment.
ages["Ringo"] = 30
echo ages["Ringo"]

# Iterate with block parameters.
ages.each do |name, age|
    echo "#{name} is #{age}"
end

# Some builtin helpers.
e! ages.keys
e! ages.values

# Example Three
# Typed empty map (`{} as K -> V`).
empty_ages = {} as str -> int
e! empty_ages.keys
e! empty_ages.values

# Example Four
greeting = {
    "greet" -> "Hi, my name is Jalyn.",
    "from" -> " I'm from the USA!"
}

echo greeting["greet"] + greeting["from"]

# Example Five
# This is adding the `Hash` to a `Map` and adds types.
person: Hash(str, int) = {
    "name" -> "Jalyn",
    "age" -> 30
}

echo person["name"]                                             # -> Jalyn
echo person["age"]                                              # -> 30

# Example Six
# The block taking half of a `Map`.
scores = {
    "a" -> 1,
    "b" -> 2,
    "c" -> 3 
}

# `map` yields (key, value) and gives back an array.
e! scores.map do |key, value|
    "#{key}=#{value}"
end

# `map_keys` yields just the key, `map_values` just the
# value.
e! scores.map_keys do |key|
    key.upcase
end
e! scores.map_values do |value|
    value * 10
end

# `each_key` and `each_value` walk one side and hand back 
# the map.
scores.each_key do |key|
    echo key
end

scores.each_value do |value|
    echo value
end

# `until` answers the first matching pair as a tuple.
e! scores.until do |key, value|
    value == 2
end

# Membership by value, and removal by key.
echo scores.has_value?(3)
echo scores.has_value?(9)

scores.delete("a")

e! scores.keys
