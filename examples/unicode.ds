#[ 
    
    Unicode Example

]#

#[

    Example of a various unicode
    passed as a string and with
    args/params.

]#

use "unicode"

# Example One: Using Unicode Characters in Strings.
message = "❤️"
echo message

# Example Two: Using Unicode Characters as Variable Names.
❤️ = "あ"
echo ❤️

# Example Three: Using Unicode Characters in Class and Method Names.
class 🔥
    あ = true
  
    def 道
        if あ
            echo "Hello!"
        end
    end
end

🔥.道

# Example Four: Using Unicode Characters in Function Names and Parameters.
def saudação(اسم, อายุ)
    echo "Hello, #{اسم}! You are #{อายุ}."
end

saudação("Jules", 25)
