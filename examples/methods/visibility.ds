#[
    Visibility Example
]#

class Person
    public def introduce
        echo "Hello, I am a person."
        secret_info
    end

    private def secret_info
        echo "This is a secret!"
    end
end

person = Person.new
person.introduce

class Database
    def connect
        echo "Public: Connecting..."
        internal_config
    end

    private def internal_config
        echo "Private: Configuring..."
    end
end

db = Database.new
db.connect

# Uncommenting the next line should raise a visibility error
# db.internal_config
