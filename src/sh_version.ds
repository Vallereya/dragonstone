#[
    -------------------------------------
    ------ SELF-HOSTED DRAGONSTONE ------
    -------------------------------------
    -------------- VERSION --------------
    -------------------------------------
]#

#[
    
    #! This is a temporary workaround for getting the 
    #! Dragonstone version for some files. Later I'm going 
    #! to change how it works.

]#

use "toml"

module Dragonstone
    module Version
        
        # During bootstrap, we have mirrored the directory 
        # with the Stage0 version of Dragonstone. The 
        # normal root path for Dragonstone is the root of 
        # the project, this is because the bootstrap 
        # process is responsible for generating its own 
        # version files, and it needs a consistent location 
        # to read from and write to. The generated version 
        # file and header can be used by the rest of the 
        # Dragonstone project, regardless of where it is 
        # located on the filesystem.
        
        ROOT_PATH = "."

        # This function reads the version number from the 
        # forge.toml file and returns it as a string. It 
        # also sets the VERSION constant to this value for 
        # use elsewhere in the codebase.
        define get_version
            PACKAGE_FILE = "#{ROOT_PATH}/forge.toml"
            config = TOML.parse_file(PACKAGE_FILE)
            table = config["PACKAGE"].as_h
            version = table["version"].as_s
            VERSION = version
            return VERSION
        end
        get_version

        # This function generates a header file that 
        # contains the version number of Dragonstone. It 
        # creates a header file with a macro definition 
        # for the version number, which can be included in 
        # the C runtime.
        define generate_header
            VERSION_PRINT = "v" + "#{VERSION}"
            VERSION_PRINT_QUOTES = "\"#{VERSION}\""

            # Gets and creates the location 
            # for the version header file.
            HEADER_LOCATION = "#{ROOT_PATH}/src/dragonstone/core/runtime/include/dragonstone/core"
            Path.create(HEADER_LOCATION)

            # Generates the version header file.
            HEADER_VERSION_FILE = "#{HEADER_LOCATION}/sh_version.h"
            GENERATE_HEADER_VERSION_FILE = "#pragma once\n#define DRAGONSTONE_VERSION #{VERSION_PRINT_QUOTES}\n"
            File.create(HEADER_VERSION_FILE, "#{GENERATE_HEADER_VERSION_FILE}", true)
        end
        generate_header

        # This function generates a version file that  
        # contains the version number of Dragonstone. It 
        # creates a simple text file with the version 
        # number, which can be read by other parts of the 
        # project or by external tools.
        define generate_version

            # Gets and creates the location for the 
            # version file.
            VERSION_LOCATION = "#{ROOT_PATH}/src"
            Path.create(VERSION_LOCATION)

            # Generates the version file.
            VERSION_FILE = "#{VERSION_LOCATION}/sh_VERSION"
            GENERATE_VERSION_FILE = "#{VERSION}\n"
            File.create(VERSION_FILE, "#{GENERATE_VERSION_FILE}", true)
        end
        generate_version
    end
end
