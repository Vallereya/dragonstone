module File
    define open(path: str, mode: str, create_dirs: bool)
        ffi.call("file_open", [path, mode, create_dirs])
    end

    define read(path: str) -> str
        ffi.call("file_read", [path])
    end

    define write(path: str, content: str, create_dirs: bool) -> int
        ffi.call("file_write", [path, content, create_dirs])
    end

    define append(path: str, content: str, create_if_missing: bool) -> int
        ffi.call("file_append", [path, content, create_if_missing])
    end

    define create(path: str, contents: str, create_dirs: bool) -> str
        ffi.call("file_create", [path, contents, create_dirs])
    end

    define delete(path: str) -> bool
        ffi.call("file_delete", [path])
    end

    define exists?(path: str) -> bool
        ffi.call("file_exists", [path])
    end

    define file?(path: str) -> bool
        ffi.call("file_is_file", [path])
    end

    define join(segments: arr(str)) -> str
        out = ""
        i   = 0

        while i < segments.length
            part = segments[i]

            unless part.empty?
                if out.empty?
                    out = part
                else
                    if out.slice(out.length - 1, 1) == "/"
                        out = out.slice(0, out.length - 1)
                    end
                    if part.slice(0, 1) == "/"
                        part = part.slice(1, part.length - 1)
                    end
                    out = out + "/" + part
                end
            end

            i = i + 1
        end

        return out
    end

    define extname(path: str) -> str
        base = Path.base(path)
        i    = base.length - 1

        while i > 0
            if base.slice(i, 1) == "."
                return base.slice(i, base.length - i)
            end
            i = i - 1
        end

        return ""
    end
end

