class Builder
    define initialize(initial_capacity: int)
        setup_buffer(initial_capacity)
    end

    define append(str: str)
        @text = @text + str
        self
    end

    define append_char(char: char)
        @text = @text + ("" + char)
        self
    end

    define back
        if @text.size > 0
            @text = @text.slice(0, @text.size - 1)
        end
        self
    end

    define to_s -> str
        @text
    end

    define increase_capacity(additional: int)
        self
    end

    define setup_buffer(initial_capacity: int)
        @text = ""
    end

    define next_capacity(needed_capacity: int) -> int
        needed_capacity
    end
end
