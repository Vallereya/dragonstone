#! Error thrown when inheriting from superclass on bootstrap here.
# class ParseException < Exception

class ParseException
    property message
    property line_number
    property column_number

    def initialize(message, @line_number, @column_number)
        @message = "#{message} at #{@line_number}:#{@column_number}"
    end

    def to_s
        @message
    end
end
