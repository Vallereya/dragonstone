module Dragonstone
    module CLI
        module ProcBootstrap
            extend self

            define bootstrap_command?(args)
                if args.length == 1
                    case args.first

                    when "--sh"
                        return true
                    end
                end
                return false
            end

            define return_bootstrap(out)
                stdout.echo "The Dragonstone Self-Hosted CLI is not yet implemented with the `--sh` flag."
                stdout.echo "Use `dragonstone run ./bin/main.ds` to run the bootstrap version of Dragonstone for now."
                return 0
            end
        end
    end
end
