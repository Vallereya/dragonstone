module Dragonstone
    module CLI
        module ProcCommon
            extend self

            define version_command?(args)
                if args.length == 1
                    case args.first

                    when "version"
                        return true
                    when "--version"
                        return true
                    when "--v"
                        return true
                    end
                end
                return false
            end

            define help_command?(args)
                if args.length == 1
                    case args.first

                    when "help"
                        return true
                    when "--help"
                        return true
                    when "--h"
                        return true
                    end
                end
                return false
            end

            define print_version(out)

                # Gets the version number from the 
                # `get_version` method within the 
                # version.ds file and prints it to the 
                # console. Also adds color to the output 
                # for better visibility.
                stdout.echo Color.new("Dragonstone v#{Version.get_version}").foreground_rgb(84, 6, 213).to_display
                return 0
            end

            define print_help(out)
                print_usage(out)
                return 0
            end

            define show_startup(out)
                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display
                stdout.echo Color.new(  "                               WELCOME TO DRAGONSTONE!                              ").foreground_rgb(84, 6, 213).to_display
                stdout.echo Color.new(  "                                       v#{Version.get_version}                      ").foreground_rgb(84, 6, 213).to_display
                print_usage(out)
                return 1
            end

            define print_usage(out)
                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display
                stdout.echo Color.new(  "                         DRAGONSTONE COMMAND LINE INTERFACE                         ").foreground_rgb(188, 0, 45).to_display
                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display
                stdout.echo Color.new(  "Usage:                                                                              ").foreground_rgb(188, 0, 45).to_display
                stdout.echo             "   dragonstone <command> [options]                                                  "
                stdout.echo             "                                                                                    "
                stdout.echo Color.new(  "Commands:                                                                           ").foreground_rgb(188, 0, 45).to_display
                stdout.echo             "   version, --version, --v                    Show Version                          "
                stdout.echo             "   help, --help, --h                          Show Help                             "
                stdout.echo             "   capability, --capability, --c              Show Backend Capabilities             "
                # stdout.echo             "   --sh                                       Uses the Bootstrap Version/CLI        "
                stdout.echo             "   lex <file>                                 Tokenize a File                       "
                stdout.echo             "   parse <file>                               Parse a File & Show AST               "
                stdout.echo             "   run <file>                                 Run a File                            "
                stdout.echo             "   build [options] <file>                     Build a File                          "
                stdout.echo             "   build-run [options] <file>                 Build and Run a File                  "
                stdout.echo             "   repl                                       Starts REPL                           "
                stdout.echo             "                                                                                    "
                stdout.echo Color.new(  "Options:                                                                            ").foreground_rgb(188, 0, 45).to_display
                stdout.echo             "   <command> [--typed] <file>                 Force types in a File                 "
                stdout.echo             "   <command> [--backend <backend>] <file>     Choose a backend to use               "
                stdout.echo             "                         auto                     = default backend (native)        "
                stdout.echo             "                         native                   = interpreter backend             "
                stdout.echo             "                         core                     = compiler backend                "
                stdout.echo             "   <command> [--target <target>] <file>       Choose a target to build for          "
                stdout.echo             "                        bytecode                  = default target                  "
                stdout.echo             "                        llvm                      = llvm target                     "
                stdout.echo             "                        c                         = c target                        "
                # stdout.echo             "                        crystal                   = crystal target                  "
                # stdout.echo             "                        ruby                      = ruby target                     "
                # stdout.echo             "                        python                    = python target                   "
                # stdout.echo             "                        javascript                = javascript target               "
                stdout.echo             "   <command> [--output <dir>] <file>          Choose a target location to build to  "
                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display
            end
        end
    end
end
