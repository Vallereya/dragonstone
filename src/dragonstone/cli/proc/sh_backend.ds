module Dragonstone
    module CLI
        module ProcBackend
            extend self

            # Using String keys instead of Symbols for compatibility
            con STATUS_LABELS = {
                "full"    -> "yes",
                "partial" -> "partial",
                "planned" -> "planned",
                "none"    -> "no"
            }

            con CAPABILITIES = [
                { "feature" -> "Typed Programs",                "native" -> "none", "core" -> "none", "notes" -> "Optional Types enforced."                 },
                { "feature" -> "Block Control Flow",            "native" -> "none", "core" -> "none", "notes" -> "Control flows on backends."               },
                { "feature" -> "FFI via ffi.call_* Helpers",    "native" -> "none", "core" -> "none", "notes" -> "Call bindings w/o switching backends."    },
                { "feature" -> "Build Target: Bytecode (VM)",   "native" -> "none", "core" -> "none", "notes" -> "Emit VM Bytecode artifacts."              },
                { "feature" -> "Build Target: LLVM IR",         "native" -> "none", "core" -> "none", "notes" -> "Generate LLVM IR runnable via LLI."       },
                { "feature" -> "Build Target: C",               "native" -> "none", "core" -> "none", "notes" -> "Produce stubs for external toolchains."   }
                # { "feature" -> "Build Target: Crystal",         "native" -> "none", "core" -> "full", "notes" -> "Export Crystal-compatible source."        },
                # { "feature" -> "Build Target: Ruby",            "native" -> "none", "core" -> "full", "notes" -> "Export Ruby-compatible source."           },
                # { "feature" -> "Build Target: Python",          "native" -> "none", "core" -> "full", "notes" -> "Export Python-compatible source."         },
                # { "feature" -> "Build Target: JavaScript",      "native" -> "none", "core" -> "full", "notes" -> "Export JavaScript-compatible source."     }
            ]

            define status_label(status)
                value = STATUS_LABELS[status]

                if value
                    return value
                end
                return status
            end

            define pad_right(text, count)
                x = "#{text}"
                y = x.length
                
                if y >= count
                    return x
                end

                z = count - y
                pad = ""

                (1..z).each do |i|
                    pad = pad + " "
                end
                return x + pad
            end

            define capability_command?(args)
                if args.length == 1
                    case args.first

                    when "capability"
                        return true
                    when "--capability"
                        return true
                    when "--c"
                        return true
                    end
                end
                return false
            end

            define print_capability(out)
                print_information(out)
                return 0
            end

            define print_information(out)
                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display
                stdout.echo Color.new(  "                           Backend Supported Capabilities                           ").foreground_rgb(188, 0, 45).to_display
                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display
                
                h1 = self.pad_right("Feature", 28)
                h2 = self.pad_right("Native", 7)
                h3 = self.pad_right("Core", 7)

                stdout.echo "#{h1} #{h2} #{h3} Notes"
                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display

                CAPABILITIES.each do |entry|
                    col1            = self.pad_right(entry["feature"], 28)
                    native_status   = self.status_label(entry["native"])
                    core_status     = self.status_label(entry["core"])
                    col2            = self.pad_right(native_status, 7)
                    col3            = self.pad_right(core_status, 7)
                    notes           = entry["notes"]

                    stdout.echo "#{col1} #{col2} #{col3} #{notes}"
                end

                stdout.echo Color.new(  "------------------------------------------------------------------------------------").foreground_rgb(84, 6, 213).to_display
            end
        end
    end
end
