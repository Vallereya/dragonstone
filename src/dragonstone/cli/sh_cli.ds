#[
    -------------------------------------
    ------ SELF-HOSTED DRAGONSTONE ------
    -------------------------------------
    ---------------- CLI ----------------
    -------------------------------------
]#

# Gives Color to the CLI output.
use "colorize"

# Hands off command to the Orchestration layer.
use "../../sh_dragonstone"

# Gives access to common CLI functions.
use "./proc/sh_backend"
use "./proc/sh_bootstrap"
use "./proc/sh_common"
use "./proc/sh_options"

# Gives access to the Orchestration layer's backend.
#! Rewire this back in.
# use "./etc/sh_lex"
# use "./etc/sh_parse"
# use "./etc/sh_build"
# use "./etc/sh_run"
use "./etc/sh_repl"

# Main entry point for the CLI. This is the first 
# function that gets called when the CLI is executed.
module Dragonstone
    module CLI
        extend self

        # Here we define the `run` function, which 
        # serves as the main entry point for the CLI.
        # 
        # It takes in optional parameters for arguments, 
        # output, error, and input streams. If these 
        # parameters are not provided, it defaults to 
        # using the command-line arguments and standard 
        # streams.
        define run(args = nil, out = nil, ex = nil, in = nil): int

            # We check if the arguments and streams are 
            # nil, and if so, we assign them to the 
            # default values.
            if args == nil && out == nil && ex == nil && in == nil
                args = argv
                out = stdout
                ex = stderr
                in = stdin
            end

            # If no arguments are provided, we show the 
            # startup message and return 0 to indicate 
            # successful execution.
            if args.empty?
                ProcCommon.show_startup(out)
                return 0
            end

            # Check if the version command is used.
            # Returns 0 and prints the current version
            # of Dragonstone to the console.
            if ProcCommon.version_command?(args)
                ProcCommon.print_version(out)
                return 0
            end

            # Check if the help command is used.
            # Returns 0 and prints the help message to the 
            # console.
            if ProcCommon.help_command?(args)
                ProcCommon.print_help(out)
                return 0
            end

            # Check if the capability command is used.
            # Returns 0 and prints the capabilities of the
            # Dragonstone CLI to the console.
            if ProcBackend.capability_command?(args)
                ProcBackend.print_capability(out)
                return 0
            end

            # Check if the bootstrap command is used.
            # Returns 0 and runs the arguments through
            # the bootstrap version of Dragonstone.

            #! Needs added to run the bootstrap version 
            #! via the `--sh` flag. This is a temporary
            #! workaround until the self-hosted version
            #! is fully implemented.
            if ProcBootstrap.bootstrap_command?(args)
                ProcBootstrap.return_bootstrap(out)
                return 0
            end

            # Then we extract the command from the arguments
            # and prepare the remaining arguments for 
            # further processing.
            command = args[0]

            # This section of code is a workaround to 
            # extract the remaining arguments after the 
            # command.
            #! Temporary workaround since I haven't
            #! added a way to call `.length` on a Range.
            #! WAS: `args = [1..-1]`
            remaining_args = []
            i = 1
            while i < args.length
                remaining_args.push(args[i])
                i = i + 1
            end
            args = remaining_args
            
            # Based on the command provided, we call the
            # appropriate handler function from the 
            # respective modules. Each command has its own
            # handler that processes the command and its
            # arguments, and returns an integer status code.
            case command

            # Lex a file and return the tokens.
            when "lex"
                return EtcLex.handle_lex_command(args, out, ex)
            
            # Parse a file and return the AST.
            when "parse"
                return EtcParse.handle_parse_command(args, out, ex)

            # Run a file and return the output.
            when "run"
                return EtcRun.run_command(args, out, ex, in)

            # Build a file.
            when "build"
                return EtcBuild.build_command(args, out, ex)
            
            # Build and run a file.
            when "build-run"
                return EtcBuild.build_and_run_command(args, out, ex)

            # Start a REPL session.
            when "repl"
                return EtcRepl.start_repl(args, out, ex, in)

            # Returns 0 and prints a message for testing 
            # purposes for the CLI.
            when "test"
                # out << "Test command executed!"
                out << Color.new("Test command executed!").foreground_rgb(55, 145, 68).to_display
                return 0

            # Returns 1 and prints an error message for 
            # unknown commands. It also suggests using the 
            # 'help' command.
            else
                # ex << "Unknown command: `#{command}`; Use 'help' to see available commands."
                msg1 = "Unknown command: "
                msg2 = "`#{command}`"
                msg3 = "\nUse "
                msg4 = "'help'"
                msg5 = " to see available commands."
                
                ex << Color.new(msg1).foreground_rgb(188, 0, 45).to_display + Color.new(msg2).foreground_rgb(243, 230, 0).to_display + Color.new(msg3).foreground_rgb(188, 0, 45).to_display + Color.new(msg4).foreground_rgb(55, 145, 68).to_display + Color.new(msg5).foreground_rgb(188, 0, 45).to_display
                return 1
            end
        end
    end
end
